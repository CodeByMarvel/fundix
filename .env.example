# Copy this file to .env and fill in your values.
# .env is gitignored — .env.example is safe to commit.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
BACKEND_URL=http://localhost:3000

# M-Pesa Daraja (Safaricom) — get from https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-url.com
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=

# Escrow auto-release buffer
# 2 = 2 minutes (good for testing)
# 120 = 2 hours (recommended for production)
ESCROW_RELEASE_BUFFER_MINUTES=2
